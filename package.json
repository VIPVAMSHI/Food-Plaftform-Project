{
  "name": "seattle-food-discovery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors cyan,green \"vite\" \"npm --prefix server run dev\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && npm --prefix server run typecheck && vite build",
    "start": "npm --prefix server start",
    "preview": "vite preview",
    "postinstall": "npm --prefix server install --no-audit --no-fund"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}

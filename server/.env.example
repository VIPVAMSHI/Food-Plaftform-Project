# Every server setting, for both ways of running the app:
#   Local (`npm start` / `npm run dev`): copy this file to server/.env and edit. Nothing is required locally.
#   Vercel: do NOT upload this file. Add each variable marked "Vercel: yes" in
#     Project → Settings → Environment Variables (or `vercel env add NAME production`). See VERCEL_DEPLOY.md.
#     Changes apply to the next deployment only: redeploy after editing.
# server/.env is gitignored. Never commit real keys or tokens. Never put a secret in a VITE_ variable:
# anything prefixed VITE_ is compiled into the public JavaScript. This app has no VITE_ variables.

# ---------------------------------------------------------------------------------------------------------------
# Database (plans and favorites only; the 68 places ship with the code)
# ---------------------------------------------------------------------------------------------------------------

# Vercel: yes, REQUIRED (Production and Preview). Locally: optional.
# libSQL URL. Turso: libsql://<database>-<org>.turso.io (from `turso db show <database> --url`).
# Local file: file:./data/bite.db (relative to server/). When empty, the local server uses DB_PATH,
# then server/data/bite.db. On Vercel, empty means plans and favorites are off and /api/health says so.
# DATABASE_URL=

# Vercel: yes, REQUIRED with Turso (Production and Preview), mark it Sensitive. Locally: not needed for file: URLs.
# From `turso db tokens create <database>`. Never printed by the app or its scripts.
# DATABASE_AUTH_TOKEN=

# Vercel: no. Render and older setups: the SQLite file path (render.yaml sets /var/data/bite.db).
# Used only when DATABASE_URL is empty.
# DB_PATH=./data/bite.db

# ---------------------------------------------------------------------------------------------------------------
# Live AI assistant (optional everywhere: without a key the assistant answers from the demo cache and local matcher)
# ---------------------------------------------------------------------------------------------------------------

# Vercel: yes, optional (Production; add Preview too if previews should use the live model), mark it Sensitive.
# A Google (Gemini) API key from https://aistudio.google.com/apikey. Read only by the server, never sent to the browser.
LLM_API_KEY=

# Vercel: yes, REQUIRED when LLM_API_KEY is set (same environments as the key). Not a secret.
# Pick a fast model with thinking off by default: thinking models can miss the 6 second answer deadline,
# and the app then falls back to basic matching. On Vercel a key without a model turns the live model off.
LLM_MODEL=gemini-2.5-flash-lite

# Vercel: optional. google is the only provider.
LLM_PROVIDER=google

# ---------------------------------------------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------------------------------------------

# Vercel: optional. Show which path answered (llm / cache / local) under each assistant reply.
# Also available per page with ?debug=1. Keep false for an audience.
DEMO_DEBUG=false

# Vercel: optional. Plan and favorite changes per browser per minute (each network IP gets ten times this). Default 60.
# WRITES_PER_MINUTE=60

# Vercel: optional. fatal | error | warn | info | debug | trace | silent. Logs never contain keys or chat messages.
LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------------------------
# Local server only (Vercel: no; ignored there)
# ---------------------------------------------------------------------------------------------------------------

# development | production | test. `npm start` forces production. Vercel always runs as production.
NODE_ENV=development

# Port for the API (and, in production, the web app). Render sets it for you.
PORT=3001

# Defaults to 127.0.0.1 locally and 0.0.0.0 in production.
# HOST=127.0.0.1

# File that keeps live-model answers across restarts, relative to server/. Vercel uses the bundled demo cache
# (`npm run cache:build`) plus an in-memory cache instead.
CACHE_PATH=./data/assistant-cache.json

# In-app "add an API key" prompt. Defaults to on in development and off in production. Always off on Vercel.
# AI_KEY_PROMPT=on

# Origin allowed by CORS in development (the Vite dev server).
# DEV_ORIGIN=http://localhost:5173
